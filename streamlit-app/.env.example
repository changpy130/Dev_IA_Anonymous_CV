# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Base URL of your n8n instance (no trailing slash)
N8N_BASE_URL=http://localhost:5678

# Same value as the Header Auth credential in n8n (header: X-API-Key)
# Generate one with: openssl rand -hex 24
N8N_API_KEY=replace-with-a-long-random-key

# Password to open the Streamlit app
APP_PASSWORD=replace-with-your-own-password
